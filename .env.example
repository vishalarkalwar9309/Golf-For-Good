# ==============================================================================
# CLIENT-SAFE ENVIRONMENT VARIABLES (VITE_)
# Accessible by the browser. Safe for public credentials only.
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# NEVER expose these in client bundles or prefix with VITE_.
# Set in Vercel project settings or local .env.local for serverless execution.
# ==============================================================================
# Supabase Service Role (used by webhook handler and admin scripts to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Secret & Webhook (TEST MODE ONLY - sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Deployed Site URL (used for Stripe Checkout success/cancel redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
